# AI Brain - Production Environment Configuration
# Copy this file to .env on production server

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# DATABASE (Use production credentials)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://user:password@prod-db-host:5432/ai_brain_prod

# =============================================================================
# REDIS & CELERY (REQUIRED in Production)
# =============================================================================
# Production requires Redis for task queue
# Application will fail to start if Redis is unavailable
CELERY_BROKER_URL=redis://prod-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://prod-redis-host:6379/1

# =============================================================================
# DOCUMENT EXTRACTION (Production - Document AI)
# =============================================================================
# In production, we use Google Document AI for 95-99% accuracy
# Cost: ~$1.50 per 1000 pages (first 1000 pages/month FREE)
USE_DOCUMENT_AI_IN_PRODUCTION=true

# Google Document AI Configuration
# Setup: https://cloud.google.com/document-ai/docs/setup
GCP_PROJECT_ID=your-gcp-project-id
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=your-processor-id
DOCUMENTAI_MIN_CONFIDENCE=0.8

# Google Cloud Authentication
# Set path to service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# SENTRY (Error Tracking - ENABLED in Production)
# =============================================================================
SENTRY_ENABLED=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1  # Sample 10% of transactions

# =============================================================================
# OPENAI
# =============================================================================
OPENAI_API_KEY=your-production-openai-key

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/ai_brain/app.log
LOG_TO_CONSOLE=true

# =============================================================================
# SECURITY
# =============================================================================
# Add CORS origins for production
CORS_ORIGINS=["https://your-production-domain.com"]

# =============================================================================
# PERFORMANCE
# =============================================================================
# Celery worker configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
