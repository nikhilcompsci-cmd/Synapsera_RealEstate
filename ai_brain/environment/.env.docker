# Docker environment variables for AI Brain
# This file is used by docker-compose.yml

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_brain

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Application Configuration
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# OpenAI Configuration
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1000

# Document AI Configuration (Optional)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-cloud-key.json
ENABLE_DOCUMENT_AI=false
DOCUMENT_AI_PROJECT_ID=your_project_id
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your_processor_id

# Sentry Configuration (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# File Upload Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=/app/data/documents

# FAISS Configuration
FAISS_INDEX_PATH=/app/data/faiss_indices
