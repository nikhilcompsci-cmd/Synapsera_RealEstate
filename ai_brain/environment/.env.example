# Application Settings
APP_NAME="AI Brain - Real Estate Document Analysis"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development  # development, staging, production

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
LOG_TO_CONSOLE=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_brain
DB_ECHO=false

# API Configuration
API_V1_PREFIX=/api/v1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Celery Task Queue Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Data Storage
DATA_DIR=data

# OpenAI Configuration (Sprint 3)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1000  # Increased from 500 for comprehensive answers


