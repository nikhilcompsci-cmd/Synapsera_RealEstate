# Sentry Configuration
# ==================
# Error tracking and monitoring service
# Get your DSN from: https://sentry.io/settings/projects/

# Sentry DSN (Data Source Name)
# Format: https://<key>@<organization>.ingest.sentry.io/<project>
SENTRY_DSN=

# Sentry Environment (production, staging, development)
SENTRY_ENVIRONMENT=development

# Sentry Traces Sample Rate (0.0 to 1.0)
# 1.0 = 100% of transactions, 0.1 = 10% of transactions
SENTRY_TRACES_SAMPLE_RATE=1.0

# Sentry Enable (true/false)
SENTRY_ENABLED=false
