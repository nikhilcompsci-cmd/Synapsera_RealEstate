# AI Brain - Development Environment Configuration
# Copy this file to .env and customize for your local development

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_brain

# =============================================================================
# REDIS & CELERY (Optional in Development)
# =============================================================================
# If Redis is not available, application will start with warnings
# Document processing will work but be slower (sync mode)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# DOCUMENT EXTRACTION (Development)
# =============================================================================
# In development, we use FREE local OCR (pdfplumber + pytesseract)
# No external API costs
USE_DOCUMENT_AI_IN_DEVELOPMENT=false

# Google Document AI (leave empty for development)
GCP_PROJECT_ID=
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=
DOCUMENTAI_MIN_CONFIDENCE=0.8

# =============================================================================
# SENTRY (Disabled in Development)
# =============================================================================
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# OPENAI (Optional)
# =============================================================================
OPENAI_API_KEY=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

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
LOG_TO_CONSOLE=true
